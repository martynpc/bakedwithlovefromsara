---
import { getCollection, render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { site } from '../../site.config';

export async function getStaticPaths() {
  const cakes = await getCollection('cakes');
  return cakes.map((cake) => ({ params: { id: cake.id }, props: { cake } }));
}

const { cake } = Astro.props;
const { Content } = await render(cake);
const og = await getImage({ src: cake.data.cover, width: 1200, format: 'jpeg' });
const ogUrl = new URL(og.src, Astro.site).toString();
const isCourse = cake.data.occasion === 'Course';
const alt = isCourse ? `${site.baker} in her kitchen` : cake.data.title;
const askLabel = isCourse ? 'Ask about the next course' : 'Ask about one like this';
---

<Base title={cake.data.title} description={cake.data.summary} ogImage={ogUrl}>
  <article class="pt-28 md:pt-36">
    <div class="wrap grid md:grid-cols-12 gap-8 md:gap-14">
      <div class="md:col-span-7">
        <Image
          src={cake.data.cover}
          alt={alt}
          widths={[640, 1024, 1600]}
          sizes="(min-width: 768px) 58vw, 100vw"
          loading="eager"
          class="w-full h-auto md:max-h-[78vh] object-cover rounded-2xl"
        />
        {cake.data.gallery.length > 0 && (
          <div class="mt-4 grid grid-cols-2 gap-4">
            {cake.data.gallery.map((g) => (
              <Image src={g} alt="" widths={[480, 800]} sizes="(min-width: 768px) 29vw, 50vw" loading="lazy" class="w-full h-auto rounded-xl" />
            ))}
          </div>
        )}
      </div>

      <div class="md:col-span-5 md:sticky md:top-28 self-start">
        <p class="text-taupe-soft">{cake.data.occasion}</p>
        <h1 class="display-lg mt-1">{cake.data.title}</h1>
        <div class="prose-soft mt-6 text-[1.1rem] leading-[1.7] space-y-4">
          <Content />
        </div>

        {(cake.data.flavours.length > 0 || cake.data.serves || cake.data.fromPrice) && (
          <dl class="mt-8 grid grid-cols-[auto_1fr] gap-x-6 gap-y-2 text-[0.98rem]">
            {cake.data.flavours.length > 0 && (<><dt class="text-taupe-soft">Flavours</dt><dd class="text-cocoa">{cake.data.flavours.join(', ')}</dd></>)}
            {cake.data.serves && (<><dt class="text-taupe-soft">Serves</dt><dd class="text-cocoa">{cake.data.serves}</dd></>)}
            {cake.data.fromPrice && (<><dt class="text-taupe-soft">From</dt><dd class="text-cocoa">{cake.data.fromPrice}</dd></>)}
          </dl>
        )}

        <div class="mt-10 flex flex-wrap gap-3">
          <a href={site.messenger} class="btn" target="_blank" rel="noopener">{askLabel}</a>
          <a href="/#cakes" class="btn btn-quiet">Back to the cakes</a>
        </div>
      </div>
    </div>
  </article>
</Base>
