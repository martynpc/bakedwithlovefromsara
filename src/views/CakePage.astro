---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { site } from '../site.config';
import { cakeImage } from '../lib/images';
import { cakeText, href, ui, type Lang } from '../i18n';
import { cakeSchemas } from '../lib/schema';

interface Props { cake: CollectionEntry<'cakes'>; lang: Lang }
const { cake, lang } = Astro.props;
const t = ui[lang];
const ct = cakeText(cake, lang);
const { Content } = await render(cake);
const og = await getImage({ src: cakeImage(cake.data.cover), width: 1200, format: 'jpeg' });
const ogUrl = new URL(og.src, Astro.site).toString();
const isCourse = cake.data.occasion === 'Course';
const alt = isCourse ? t.inKitchen(site.baker) : ct.title;
const askLabel = isCourse ? t.coursesAsk : t.askLikeThis;
const paras = (ct.description || ct.summary).split(/\n{2,}/).filter(Boolean);
const isEn = lang === 'en';
---

<Base lang={lang} title={ct.title} description={ct.summary} ogImage={ogUrl} ogImageAlt={ct.title} schema={cakeSchemas(cake, lang, ogUrl)}>
  <article class="pt-28 md:pt-36">
    <div class="wrap grid md:grid-cols-12 gap-8 md:gap-14">
      <div class="md:col-span-7">
        <Image
          src={cakeImage(cake.data.cover)}
          alt={alt}
          widths={[640, 1024, 1600]}
          sizes="(min-width: 768px) 58vw, 100vw"
          loading="eager"
          fetchpriority="high"
          style={`object-position: center ${cake.data.focus === 'top' ? '10%' : cake.data.focus === 'bottom' ? '90%' : '50%'}`}
          quality={75}
          class="w-full h-auto md:max-h-[78vh] object-cover rounded-2xl"
        />
        {cake.data.gallery.length > 0 && (
          <div class="mt-4 grid grid-cols-2 gap-4">
            {cake.data.gallery.map((g) => (
              <Image src={cakeImage(g)} alt="" widths={[480, 800]} sizes="(min-width: 768px) 29vw, 50vw" loading="lazy" class="w-full h-auto rounded-xl" />
            ))}
          </div>
        )}
      </div>

      <div class="md:col-span-5 md:sticky md:top-28 self-start">
        <p class="text-taupe-soft">{t.occasion[cake.data.occasion]}</p>
        <h1 class="display-lg mt-1">{ct.title}</h1>
        <div class="mt-6 text-[1.1rem] leading-[1.7] space-y-4">
          {isEn && <Content />}
          {!isEn && paras.map((para) => <p>{para}</p>)}
        </div>

        {(ct.flavours.length > 0 || ct.serves || ct.fromPrice) && (
          <dl class="mt-8 grid grid-cols-[auto_1fr] gap-x-6 gap-y-2 text-[0.98rem]">
            {ct.flavours.length > 0 && (<><dt class="text-taupe-soft">{t.flavours}</dt><dd class="text-cocoa">{ct.flavours.join(', ')}</dd></>)}
            {ct.serves && (<><dt class="text-taupe-soft">{t.serves}</dt><dd class="text-cocoa">{ct.serves}</dd></>)}
            {ct.fromPrice && (<><dt class="text-taupe-soft">{t.priceFrom}</dt><dd class="text-cocoa">{ct.fromPrice}</dd></>)}
          </dl>
        )}

        <div class="mt-10 flex flex-wrap gap-3">
          <a href={site.messenger} class="btn" target="_blank" rel="noopener">{askLabel}</a>
          <a href={href(lang, '/#cakes')} class="btn btn-quiet">{t.backToCakes}</a>
        </div>
      </div>
    </div>
  </article>
</Base>
