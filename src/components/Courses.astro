---
import { site } from '../site.config';
import { ui, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
---

<section id="courses" class="scroll-mt-20 mt-24 md:mt-32 bg-blush/60">
  <div class="wrap py-16 md:py-24 grid md:grid-cols-12 gap-8 md:gap-16 items-center">
    <div class="md:col-span-7">
      <h2 class="display-lg">{t.coursesTitle}</h2>
      <p class="mt-5 text-[1.1rem] leading-[1.7]">{t.coursesText}</p>
    </div>
    <div class="md:col-span-5 md:justify-self-end">
      <a href={site.messenger} class="btn" target="_blank" rel="noopener">{t.coursesAsk}</a>
      <p class="mt-3 text-[0.9rem] text-taupe-soft">{t.coursesNote}</p>
    </div>
  </div>
</section>
