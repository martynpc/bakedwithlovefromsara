---
import { site } from '../site.config';
---

<section id="courses" class="scroll-mt-20 mt-24 md:mt-32 bg-blush/60">
  <div class="wrap py-16 md:py-24 grid md:grid-cols-12 gap-8 md:gap-16 items-center">
    <div class="md:col-span-7">
      <h2 class="display-lg">Baking for people who think they can’t</h2>
      <p class="mt-5 text-[1.1rem] leading-[1.7]">
        Sára teaches beginners to bake light, simple cakes from everyday ingredients, step by step
        and without stress.
      </p>
    </div>
    <div class="md:col-span-5 md:justify-self-end">
      <a href={site.messenger} class="btn" target="_blank" rel="noopener">Ask about the next course</a>
      <p class="mt-3 text-[0.9rem] text-taupe-soft">Dates are announced on Facebook first.</p>
    </div>
  </div>
</section>
