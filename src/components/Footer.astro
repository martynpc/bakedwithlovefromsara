---
import { site } from '../site.config';
import { href, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const year = new Date().getFullYear();
const location = lang === 'sk' ? 'Dorset, Spojené kráľovstvo' : site.location;
---

<footer class="border-t border-line mt-24">
  <div class="wrap py-10 md:py-14 flex flex-col md:flex-row md:items-end md:justify-between gap-8">
    <div>
      <p class="font-display text-2xl text-cocoa">{site.name}</p>
      <p class="mt-1 text-taupe-soft text-[0.95rem]">{site.baker}, {location}</p>
    </div>
    <ul class="flex flex-wrap gap-x-7 gap-y-2 text-[0.95rem]">
      <li><a class="link" href={site.facebook} rel="me noopener" target="_blank">Facebook</a></li>
      {site.instagram && <li><a class="link" href={site.instagram} rel="me noopener" target="_blank">Instagram</a></li>}
      <li><a class="link" href={`mailto:${site.email}`}>{site.email}</a></li>
    </ul>
  </div>
  <div class="wrap pb-8 flex flex-wrap gap-x-6 gap-y-1 text-[0.8rem] text-taupe-soft">
    <span>© {year} {site.name}</span>
    <a class="link !text-taupe-soft" href={href(lang, '/privacy')}>{lang === 'sk' ? 'Ochrana súkromia' : 'Privacy'}</a>
  </div>
</footer>
