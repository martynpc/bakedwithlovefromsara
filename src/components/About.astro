---
import { site } from '../site.config';
---

<section id="about" class="scroll-mt-20 pt-24 md:pt-32">
  <div class="wrap grid md:grid-cols-12 gap-10 md:gap-16 items-start">
    <div class="md:col-span-5">
      <h2 class="display-lg">How Sara bakes</h2>
    </div>
    <div class="md:col-span-7 space-y-5 text-[1.1rem] md:text-[1.15rem] leading-[1.7]">
      <p>
        Light sponges, real whipped cream and fresh fruit. No artificial colours, flavourings or
        “cake improvers”, and nothing you couldn’t buy in a normal shop.
      </p>
      <p>
        {site.baker} bakes from her home kitchen in Dorset, one cake at a time. Each one is baked the
        day before it’s collected, so it tastes the way it looks.
      </p>
      <p class="text-taupe-soft text-[1rem]">
        Registered food business with Dorset Council. Hygiene rating available on request.
      </p>
    </div>
  </div>
</section>
