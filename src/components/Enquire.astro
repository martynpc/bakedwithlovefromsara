---
// Order form. Nothing is sent from the website: pressing the button writes a
// tidy message from the answers, copies it, and opens Facebook Messenger
// (m.me/saralovebakecakes?text=…) with it pre-filled. Sara keeps every order
// in one place, Messenger, and the site stays static with no form service.
import { site, siteText } from '../site.config';
import { ui, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const text = siteText(lang);
const labels = { ...t.msg, soon: t.formSoon, copied: t.formCopied, copy: t.formCopy };
---

<section id="enquire" class="scroll-mt-20 pt-24 md:pt-32">
  <div class="wrap grid md:grid-cols-12 gap-10 md:gap-16">
    <div class="md:col-span-5">
      <h2 class="display-lg">{t.enquireTitle}</h2>
      <p class="mt-5 text-[1.05rem]">{t.enquireText}</p>
      <p class="mt-3 text-[0.95rem] text-taupe-soft">{text.leadTime}</p>
      {text.capacity && <p class="mt-2 text-[0.95rem] text-taupe-soft">{text.capacity}</p>}

      <div class="mt-8 flex flex-col items-start gap-3">
        <a href={site.messenger} class="btn btn-quiet" target="_blank" rel="noopener">{t.messageFacebook}</a>
        {site.whatsapp && <a href={site.whatsapp} class="btn btn-quiet" target="_blank" rel="noopener">{t.messageWhatsApp}</a>}
        <a href={`mailto:${site.email}?subject=${encodeURIComponent(t.emailSubject)}`} class="link mt-2 text-[0.95rem]">{t.orEmail(site.email)}</a>
      </div>
    </div>

    <div class="md:col-span-7">
      <form id="order-form" class="grid gap-4" data-messenger={site.messenger} data-labels={JSON.stringify(labels)} novalidate>
        <div class="grid sm:grid-cols-2 gap-4">
          <label class="grid gap-1.5 text-[0.9rem] text-cocoa">
            {t.formName}
            <input class="field" name="name" required autocomplete="name" />
          </label>
          <label class="grid gap-1.5 text-[0.9rem] text-cocoa">
            {t.formOccasion}
            <select class="field" name="occasion">
              {t.formOccasions.map((o) => <option>{o}</option>)}
            </select>
          </label>
        </div>
        <div class="grid sm:grid-cols-2 gap-4">
          <label class="grid gap-1.5 text-[0.9rem] text-cocoa">
            {t.formDate}
            <input class="field" type="date" name="date" aria-describedby="date-soon" />
          </label>
          <label class="grid gap-1.5 text-[0.9rem] text-cocoa">
            {t.formPeople}
            <input class="field" type="number" name="people" min="1" max="500" inputmode="numeric" />
          </label>
        </div>
        <p id="date-soon" class="text-[0.9rem] text-berry" aria-live="polite" hidden></p>
        <div class="grid sm:grid-cols-2 gap-4">
          <label class="grid gap-1.5 text-[0.9rem] text-cocoa">
            {t.formFlavours}
            <input class="field" name="flavours" placeholder={t.formFlavoursHint} />
          </label>
          <label class="grid gap-1.5 text-[0.9rem] text-cocoa">
            {t.formBudget}
            <input class="field" name="budget" placeholder="£" />
          </label>
        </div>
        <label class="grid gap-1.5 text-[0.9rem] text-cocoa">
          {t.formAvoid}
          <input class="field" name="avoid" />
        </label>
        <label class="grid gap-1.5 text-[0.9rem] text-cocoa">
          {t.formMessage}
          <textarea class="field min-h-28" name="notes" placeholder={t.formPlaceholder}></textarea>
        </label>
        <div class="flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-5 mt-1">
          <button type="submit" class="btn">{t.formSend}</button>
          <span class="text-[0.85rem] text-taupe-soft max-w-[34ch]">{t.formNote}</span>
        </div>
      </form>

      <div id="order-done" class="rounded-2xl bg-cream p-6 md:p-8" tabindex="-1" hidden>
        <h3 class="display-md">{t.formDoneTitle}</h3>
        <p class="mt-3">{t.formDoneText}</p>
        <pre id="order-text" class="mt-5 whitespace-pre-wrap font-body text-[0.95rem] text-cocoa bg-milk rounded-xl p-4"></pre>
        <div class="mt-5 flex flex-wrap gap-3">
          <a id="order-open" class="btn" target="_blank" rel="noopener" href={site.messenger}>{t.formOpen}</a>
          <button id="order-copy" type="button" class="btn btn-quiet">{t.formCopy}</button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('order-form') as HTMLFormElement | null;
  if (form) {
    const L = JSON.parse(form.dataset.labels || '{}');
    const base = form.dataset.messenger || 'https://m.me/saralovebakecakes';
    const done = document.getElementById('order-done')!;
    const out = document.getElementById('order-text')!;
    const open = document.getElementById('order-open') as HTMLAnchorElement;
    const copyBtn = document.getElementById('order-copy') as HTMLButtonElement;
    const soon = document.getElementById('date-soon')!;
    const dateInput = form.elements.namedItem('date') as HTMLInputElement;

    const iso = (d: Date) => new Date(d.getTime() - d.getTimezoneOffset() * 60000).toISOString().slice(0, 10);
    dateInput.min = iso(new Date());

    dateInput.addEventListener('change', () => {
      const v = dateInput.value;
      const days = v ? (new Date(v + 'T12:00').getTime() - Date.now()) / 86400000 : 99;
      soon.hidden = days >= 14;
      soon.textContent = days < 14 ? L.soon : '';
    });

    const copy = async (s: string) => {
      try { await navigator.clipboard.writeText(s); return true; } catch { return false; }
    };

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const name = form.elements.namedItem('name') as HTMLInputElement;
      if (!name.value.trim()) { name.reportValidity(); name.focus(); return; }

      const f = new FormData(form);
      const val = (k: string) => String(f.get(k) || '').trim();
      const date = val('date')
        ? new Date(val('date') + 'T12:00').toLocaleDateString(L.locale, { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' })
        : '';
      const rows: [string, string][] = [
        [L.name, val('name')],
        [L.occasion, val('occasion')],
        [L.date, date],
        [L.people, val('people')],
        [L.flavours, val('flavours')],
        [L.budget, val('budget')],
        [L.avoid, val('avoid')],
        [L.notes, val('notes')],
      ];
      const message = [L.hello, '', ...rows.filter(([, v]) => v).map(([k, v]) => `${k}: ${v}`), '', L.footer].join('\n');
      const url = `${base}?text=${encodeURIComponent(message)}`;

      copy(message);
      window.open(url, '_blank', 'noopener');

      out.textContent = message;
      open.href = url;
      form.hidden = true;
      done.hidden = false;
      done.focus();
    });

    copyBtn.addEventListener('click', async () => {
      if (await copy(out.textContent || '')) {
        copyBtn.textContent = L.copied;
        setTimeout(() => (copyBtn.textContent = L.copy), 2000);
      }
    });
  }
</script>
