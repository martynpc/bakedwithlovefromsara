---
import { site, siteText } from '../site.config';
import { ui, type Lang } from '../i18n';
// Set PUBLIC_WEB3FORMS_KEY in .env (and in Cloudflare Pages → Settings →
// Environment variables) to turn the form on. Without it, the section still
// works: Messenger and email are Sara's real order channels today.
const formKey = import.meta.env.PUBLIC_WEB3FORMS_KEY as string | undefined;

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const text = siteText(lang);
---

<section id="enquire" class="scroll-mt-20 pt-24 md:pt-32">
  <div class="wrap grid md:grid-cols-12 gap-10 md:gap-16">
    <div class="md:col-span-5">
      <h2 class="display-lg">{t.enquireTitle}</h2>
      <p class="mt-5 text-[1.05rem]">{t.enquireText}</p>
      <p class="mt-3 text-[0.95rem] text-taupe-soft">{text.leadTime}</p>

      <div class="mt-8 flex flex-col items-start gap-3">
        <a href={site.messenger} class="btn" target="_blank" rel="noopener">{t.messageFacebook}</a>
        {site.whatsapp && <a href={site.whatsapp} class="btn btn-quiet" target="_blank" rel="noopener">{t.messageWhatsApp}</a>}
        <a href={`mailto:${site.email}?subject=${encodeURIComponent(t.emailSubject)}`} class="link mt-2 text-[0.95rem]">{t.orEmail(site.email)}</a>
      </div>
    </div>

    {formKey && (
      <form class="md:col-span-7 grid gap-4" action="https://api.web3forms.com/submit" method="POST">
        <input type="hidden" name="access_key" value={formKey} />
        <input type="hidden" name="subject" value={t.formSubject} />
        <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />

        <div class="grid sm:grid-cols-2 gap-4">
          <label class="grid gap-1.5 text-[0.9rem] text-cocoa">
            {t.formName}
            <input class="field" name="name" required autocomplete="name" />
          </label>
          <label class="grid gap-1.5 text-[0.9rem] text-cocoa">
            {t.formContact}
            <input class="field" name="contact" required autocomplete="email" />
          </label>
        </div>
        <div class="grid sm:grid-cols-2 gap-4">
          <label class="grid gap-1.5 text-[0.9rem] text-cocoa">
            {t.formDate}
            <input class="field" type="date" name="date" />
          </label>
          <label class="grid gap-1.5 text-[0.9rem] text-cocoa">
            {t.formOccasion}
            <select class="field" name="occasion">
              {t.formOccasions.map((o) => <option>{o}</option>)}
            </select>
          </label>
        </div>
        <label class="grid gap-1.5 text-[0.9rem] text-cocoa">
          {t.formMessage}
          <textarea class="field min-h-36" name="message" placeholder={t.formPlaceholder}></textarea>
        </label>
        <div class="flex items-center gap-4 mt-1">
          <button type="submit" class="btn">{t.formSend}</button>
          <span class="text-[0.85rem] text-taupe-soft">{t.formNote}</span>
        </div>
      </form>
    )}
  </div>
</section>
